    "@types/jsonwebtoken": "^9.0.10",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
